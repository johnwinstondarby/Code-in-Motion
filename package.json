{
  "name": "code-in-motion",
  "version": "0.1.1",
  "description": "Reusable Localis platform for learner-controlled technical process experiences.",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/johnwinstondarby/Code-in-Motion",
  "repository": {
    "type": "git",
    "url": "https://github.com/johnwinstondarby/Code-in-Motion.git"
  },
  "bugs": {
    "url": "https://github.com/johnwinstondarby/Code-in-Motion/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:wordpress": "node tools/build-wordpress-release.mjs",
    "check:schema": "node tools/check-schema-fixtures.mjs",
    "check:architecture": "node tools/check-architecture-boundaries.mjs",
    "check:core-authority": "node tools/check-core-authority.mjs",
    "check:wordpress-packaging": "node tools/check-wordpress-packaging.mjs",
    "check:wordpress-release-tree": "node tools/check-wordpress-release-tree.mjs",
    "check:wordpress-metadata": "node tools/check-wordpress-release-metadata.mjs",
    "test": "node --test",
    "verify": "npm run check:schema && npm run check:git-content && npm run check:page-3227 && npm run check:architecture && npm run check:core-authority && npm run check:wordpress-packaging && npm run check:wordpress-release-tree && npm run check:wordpress-metadata && npm run check:workflow-gates && npm test",
    "wp-env": "wp-env",
    "generate:git-basic-cycle": "node tools/generate-git-basic-cycle.mjs",
    "check:git-content": "node tools/generate-git-basic-cycle.mjs --check",
    "generate:page-3227": "node tools/generate-page-3227-git-adapter.mjs",
    "check:page-3227": "node tools/generate-page-3227-git-adapter.mjs --check",
    "check:workflow-gates": "node tools/check-required-workflow-gates.mjs"
  },
  "devDependencies": {
    "@wordpress/env": "11.15.0",
    "ajv": "8.20.0",
    "yaml": "2.9.1"
  }
}
