{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localis.services/schemas/localis.cim.v2.schema.json",
  "title": "Code in Motion Experience v2",
  "description": "Runtime structural contract for localis.cim/v2 experiences with learner-facing beat grouping and presentation metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "engine_min", "experience_version", "id", "renderer", "presentation", "initial_state", "steps"],
  "properties": {
    "schema": { "const": "localis.cim/v2" },
    "engine_min": { "$ref": "#/$defs/semver" },
    "experience_version": { "$ref": "#/$defs/semver" },
    "id": { "$ref": "#/$defs/identifier" },
    "renderer": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*/v[1-9][0-9]*$" },
    "renderer_config": { "type": "object" },
    "presentation": { "$ref": "#/$defs/presentation" },
    "initial_state": { "not": { "type": "null" } },
    "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "identifier": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "stepId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:--s[0-9]{2})?$",
      "not": { "const": "initial" }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "subject", "beat_count", "default_playback_rate"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "subject": { "type": "string", "minLength": 1 },
        "beat_count": { "type": "integer", "minimum": 1 },
        "default_playback_rate": { "type": "number", "minimum": 0.5, "maximum": 2.0 }
      }
    },
    "beat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ordinal", "heading", "segment_ordinal", "segment_count", "final"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "ordinal": { "type": "integer", "minimum": 1 },
        "heading": { "type": "string", "minLength": 1 },
        "segment_ordinal": { "type": "integer", "minimum": 1, "maximum": 99 },
        "segment_count": { "type": "integer", "minimum": 1, "maximum": 99 },
        "final": { "type": "boolean" }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "beat", "commentary", "state"],
      "properties": {
        "id": { "$ref": "#/$defs/stepId" },
        "label": { "type": "string", "minLength": 1 },
        "marker": { "type": "string", "minLength": 1 },
        "beat": { "$ref": "#/$defs/beat" },
        "commentary": { "$ref": "#/$defs/commentary" },
        "state": { "not": { "type": "null" } },
        "renderer_config": { "type": "object" },
        "dwell_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "commentary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "links"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "links": { "type": "array", "items": { "$ref": "#/$defs/link" } }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "href"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "label": { "type": "string", "minLength": 1 },
        "href": { "type": "string", "minLength": 1, "pattern": "^(?:[hH][tT][tT][pP][sS]?://|[mM][aA][iI][lL][tT][oO]:|/|#)" }
      }
    }
  }
}
