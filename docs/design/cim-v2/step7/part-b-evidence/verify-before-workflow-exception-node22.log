              cp "dist/${ZIP_NAME}.sha256" "${CIM_R19_ARTIFACT_DIR}/${ZIP_NAME}.sha256"
              (cd "${CIM_R19_ARTIFACT_DIR}" && sha256sum --check "${ZIP_NAME}.sha256")
              
              node --input-type=module <<'NODE'
              import { writeFile } from 'node:fs/promises';
              
              const config = {
                $schema: 'https://schemas.wp.org/trunk/wp-env.json',
                core: `WordPress/WordPress#${process.env.CIM_R19_WORDPRESS}`,
                phpVersion: process.env.CIM_R19_PHP,
                plugins: [],
                port: 8893,
                testsEnvironment: false,
                config: {
                  WP_DEBUG: true,
                  SCRIPT_DEBUG: true
                },
                mappings: {
                  'wp-content/r19-artifact': process.env.CIM_R19_ARTIFACT_DIR
                }
              };
              
              await writeFile(process.env.CIM_R19_CONFIG, `${JSON.stringify(config, null, 2)}\n`, 'utf8');
              NODE
              
          6:
            name: 'Install pinned Playwright test runner'
            run: 'npm install --no-save --ignore-scripts --no-audit --no-fund @playwright/test@1.63.0'
          7:
            name: 'Install Chromium for Playwright'
            run: 'npx playwright install --with-deps chromium'
          8:
            name: 'Start PHP matrix WordPress environment'
            run: 'npm run --silent wp-env -- --config="${CIM_R19_CONFIG}" start --update'
          9:
            name: 'Verify PHP runtime and install release ZIP'
            shell: 'bash'
            run: |-
              set -euo pipefail
              ZIP_NAME="code-in-motion-${CIM_PLUGIN_VERSION}.zip"
              
              wp_env() {
                npm run --silent wp-env -- --config="${CIM_R19_CONFIG}" "$@"
              }
              
              CORE_VERSION="$(wp_env run cli wp core version | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' | tail -n 1)"
              test "${CORE_VERSION}" = "${CIM_R19_WORDPRESS}"
              
              PHP_RUNTIME="$(wp_env run cli wp eval 'echo PHP_VERSION . PHP_EOL;' | grep -E '^[0-9]+\.[0-9]+\.[0-9]+' | tail -n 1)"
              case "${PHP_RUNTIME}" in
                "${CIM_R19_PHP}".*) ;;
                *)
                  echo "R19 expected PHP ${CIM_R19_PHP}.x but found ${PHP_RUNTIME}." >&2
                  exit 1
                  ;;
              esac
              
              if wp_env run cli wp plugin is-installed code-in-motion >/dev/null 2>&1; then
                echo "R19 expected Code in Motion to be absent before ZIP installation." >&2
                exit 1
              fi
              
              wp_env run cli wp plugin install "wp-content/r19-artifact/${ZIP_NAME}" --activate
              
              STATUS="$(wp_env run cli wp plugin get code-in-motion --field=status | grep -E '^active$' | tail -n 1)"
              VERSION="$(wp_env run cli wp plugin get code-in-motion --field=version | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' | tail -n 1)"
              test "${STATUS}" = "active"
              test "${VERSION}" = "${CIM_PLUGIN_VERSION}"
              
              wp_env run cli bash -lc 'find wp-content/plugins/code-in-motion -type f -name "*.php" -print0 | xargs -0 -n1 php -l'
              
              echo "PASS: R19 WordPress ${CORE_VERSION}, PHP ${PHP_RUNTIME}, CiM ${VERSION} active."
              echo "CIM_R19_PHP_RUNTIME=${PHP_RUNTIME}" >> "${GITHUB_ENV}"
              
          10:
