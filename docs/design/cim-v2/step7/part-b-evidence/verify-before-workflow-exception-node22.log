                --post_content='[cim experience="synthetic-wordpress"]CiM E2E fallback.[/cim]'
              
              r9_content='[cim experience="synthetic-wordpress" instance="r9-one"]R9 one fallback.[/cim]
              [cim experience="synthetic-wordpress" instance="r9-two"]R9 two fallback.[/cim]
              [cim experience="synthetic-wordpress" instance="r9-three"]R9 three fallback.[/cim]'
              
              wp_env run cli wp post create \
                --post_type=page \
                --post_status=publish \
                --post_title='CiM R9 Isolation E2E' \
                --post_name='cim-e2e-r9' \
                --post_content="${r9_content}"
              
          11:
            name: 'Run R19 PHP compatibility integration suite'
