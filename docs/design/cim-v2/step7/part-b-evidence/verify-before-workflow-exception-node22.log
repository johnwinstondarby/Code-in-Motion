              CIM_WP_BASE_URL: 'http://localhost:8892'
            run: 'npx playwright test tests/e2e/wordpress-synthetic-mount.spec.mjs tests/e2e/wordpress-detached-root.spec.mjs tests/e2e/wordpress-zip-install.spec.mjs --reporter=line'
          12:
