{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "localis.cim/media/v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "localis.cim/media/v1"
    },
    "status": {
      "const": "fixture"
    },
    "placeholder": {
      "type": "boolean"
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/mediaClip"
      }
    }
  },
  "required": [
    "schema",
    "status",
    "placeholder",
    "assets"
  ],
  "$defs": {
    "mediaSource": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "pack"
            },
            "path": {
              "type": "string",
              "maxLength": 200,
              "pattern": "^(?:[a-zA-Z0-9_-]+/)*[a-zA-Z0-9_-]+(?:\\.[a-zA-Z0-9_-]+)+$"
            }
          },
          "required": [
            "type",
            "path"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "attachment"
            },
            "id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "type",
            "id"
          ]
        }
      ]
    },
    "mediaCaption": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/mediaSource"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "type": {
          "const": "text/vtt"
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "\\S"
        }
      },
      "required": [
        "source",
        "sha256",
        "size",
        "type",
        "language",
        "label"
      ]
    },
    "mediaClip": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 100,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "source": {
              "$ref": "#/$defs/mediaSource"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4194304
            },
            "type": {
              "enum": [
                "video/webm",
                "video/mp4"
              ]
            },
            "duration": {
              "type": "number",
              "minimum": 0.001,
              "maximum": 30
            },
            "alt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000,
              "pattern": "\\S"
            },
            "captions": {
              "$ref": "#/$defs/mediaCaption"
            }
          },
          "required": [
            "id",
            "source",
            "sha256",
            "size",
            "type",
            "duration",
            "alt",
            "captions"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 100,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "source": {
              "$ref": "#/$defs/mediaSource"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4194304
            },
            "type": {
              "const": "video/mp4"
            },
            "duration": {
              "type": "number",
              "minimum": 0.001,
              "maximum": 30
            },
            "alt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000,
              "pattern": "\\S"
            },
            "captions": {
              "$ref": "#/$defs/mediaCaption"
            },
            "webm": {
              "$ref": "#/$defs/mediaWebM"
            }
          },
          "required": [
            "id",
            "source",
            "sha256",
            "size",
            "type",
            "duration",
            "alt",
            "captions",
            "webm"
          ]
        }
      ]
    },
    "mediaWebM": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/mediaSource"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        },
        "type": {
          "const": "video/webm"
        },
        "duration": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 30
        },
        "captions": {
          "$ref": "#/$defs/mediaCaption"
        }
      },
      "required": [
        "source",
        "sha256",
        "size",
        "type",
        "duration",
        "captions"
      ]
    }
  }
}
