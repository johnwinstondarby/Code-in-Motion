          "maximum": 30
        },
        "captions": {
          "$ref": "#/$defs/mediaCaption"
        }
      },
      "required": [
        "source",
        "sha256",
        "size",
        "type",
        "duration",
        "captions"
      ]
    },
    "packMediaSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "pack"
        },
        "path": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^(?:[a-zA-Z0-9_-]+/)*[a-zA-Z0-9_-]+(?:\\.[a-zA-Z0-9_-]+)+$"
        }
      },
      "required": [
        "type",
        "path"
      ]
    },
    "packMediaCaption": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/packMediaSource"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "type": {
          "const": "text/vtt"
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "\\S"
        }
      },
      "required": [
        "source",
        "sha256",
        "size",
        "type",
        "language",
        "label"
      ]
    },
    "packMediaClip": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 100,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "source": {
              "$ref": "#/$defs/packMediaSource"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4194304
            },
            "type": {
              "enum": [
                "video/webm",
                "video/mp4"
              ]
            },
            "duration": {
              "type": "number",
              "minimum": 0.001,
              "maximum": 30
            },
            "alt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000,
              "pattern": "\\S"
            },
            "captions": {
              "$ref": "#/$defs/packMediaCaption"
            },
            "codec": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^(?:avc[13]\\.[0-9A-Fa-f]{6}|(?:hev1|hvc1|av01)\\.[A-Za-z0-9.]{1,72}|vp8(?:\\.0)?|vp09\\.[0-9.]{5,72})$"
            }
          },
          "required": [
            "id",
            "source",
            "sha256",
            "size",
            "type",
            "duration",
            "alt",
            "captions",
            "codec"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 100,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "source": {
              "$ref": "#/$defs/packMediaSource"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4194304
            },
            "type": {
              "const": "video/mp4"
            },
            "duration": {
              "type": "number",
              "minimum": 0.001,
              "maximum": 30
            },
            "alt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000,
              "pattern": "\\S"
            },
            "captions": {
              "$ref": "#/$defs/packMediaCaption"
            },
            "webm": {
              "$ref": "#/$defs/packMediaWebM"
            },
            "codec": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^(?:avc[13]\\.[0-9A-Fa-f]{6}|(?:hev1|hvc1|av01)\\.[A-Za-z0-9.]{1,72}|vp8(?:\\.0)?|vp09\\.[0-9.]{5,72})$"
            }
          },
          "required": [
            "id",
            "source",
            "sha256",
            "size",
            "type",
            "duration",
            "alt",
            "captions",
            "webm",
            "codec"
          ]
        }
      ]
    },
    "packMediaWebM": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/packMediaSource"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        },
        "type": {
          "const": "video/webm"
        },
        "duration": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 30
        },
        "captions": {
          "$ref": "#/$defs/packMediaCaption"
        },
        "codec": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^(?:avc[13]\\.[0-9A-Fa-f]{6}|(?:hev1|hvc1|av01)\\.[A-Za-z0-9.]{1,72}|vp8(?:\\.0)?|vp09\\.[0-9.]{5,72})$"
        }
      },
      "required": [
        "source",
        "sha256",
        "size",
        "type",
        "duration",
        "captions",
        "codec"
      ]
    }
  }
}
